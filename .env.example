# Postgres connection for BidScout (scripts/setup-db.ts creates the schema).
BIDSCOUT_DATABASE_URL=postgres://bidscout:bidscout@localhost:5432/bidscout
# Where raw responses are stored (write once, gzip, SHA-256). Git-ignored.
BIDSCOUT_DATA_DIR=.data
# Sent in the User-Agent so number 8 solutions can reach you about the scanner.
BIDSCOUT_CONTACT=
# Minimum gap between requests to number8.bid, in milliseconds (never below 1000).
BIDSCOUT_MIN_INTERVAL_MS=1200
# API port (the UI dev server proxies /api here).
BIDSCOUT_API_PORT=4328
# Hosted only: interface to listen on (0.0.0.0 in the Docker image) and the shared password
# the browser asks for. The server refuses to listen beyond localhost without a password.
BIDSCOUT_HOST=127.0.0.1
BIDSCOUT_PASSWORD=
